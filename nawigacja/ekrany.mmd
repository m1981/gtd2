%% GTD-App: mapa ekranów i sterowania (wersja robocza, stan specyfikacji po D-34)
%% Konwencje (czyta je też sprawdz.py):
%%   klasa ekran  = ekran z paskiem nawigacji (z każdego dostępne NAV)
%%   klasa modal  = przepływ pełnoekranowy bez paska; wyjście tylko krawędzią -.->
%%   klasa sukces = ekran zakończenia celu; ZP-01 wymaga wezwania ==>
%%   klasa zewn   = aplikacja spoza GTD-App
%%   %% wyjatek-zp01: ID (decyzja) = świadomy wyjątek od reguły R5
%%   -->  zwykłe przejście     ==>  wezwanie do działania (ZP-01)     -.->  wyjście / powrót
%% wyjatek-zp01: E02 (D-36)
%% pasek nawigacji: D-37
flowchart LR
  NAV(["Pasek: Start · Inbox · Działania · Projekty · Konteksty · (+)"])

  E01["E-01 Start"]
  E02["E-02 Przechwyć"]
  E03["E-03 Inbox"]
  E04["E-04 Doprecyzowanie"]
  E05["E-05 Następne działania"]
  E06["E-06 Działanie"]
  E07["E-07 Widok przygotowania"]
  E08["E-08 Projekty"]
  E09["E-09 Projekt"]
  E10["E-10 Konteksty"]
  E11["E-11 Kontekst / sklep"]
  E12["E-12 Czekam na"]
  E13["E-13 Kiedyś/może"]
  E14["E-14 Przegląd prowadzony"]
  E15["E-15 Kalendarz"]
  E16(["E-16 Inbox pusty"])
  E17["E-17 Kosz"]
  E19(["E-19 Projekt zakończony"])
  E20(["E-20 Przegląd ukończony"])
