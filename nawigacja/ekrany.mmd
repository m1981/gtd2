  NAV --> E01
  NAV --> E03
  NAV --> E05
  NAV --> E08
  NAV --> E10
  NAV -->|"(+)"| E02

  E01 ==>|"Opróżnij Inbox (N) · D-32"| E04
  E01 ==>|"Przygotuj się · D-31"| E07
  E01 ==>|"Zacznij przegląd · REV-01"| E14
  E01 ==>|"Projekt Utknięty"| E09
  E01 -->|"Czekam na"| E12
  E01 -->|"Kiedyś/może"| E13
  E01 -->|"Kalendarz"| E15
  E01 -->|"Kosz"| E17

  E02 -.->|"Zapisz / Anuluj"| E01

  E03 ==>|"Opróżnij Inbox"| E04
  E03 -->|"Element"| E04

  E04 -->|"Zrób teraz · D-33 / wynik"| E04
  E04 ==>|"Inbox pusty"| E16
  E04 -.->|"Przerwij"| E03
  E04 -.->|"Wróć do Przeglądu"| E14

  E16 ==>|"Wybierz działanie"| E05
  E16 -->|"Start"| E01

  E05 -->|"Działanie"| E06
  E06 ==>|"Przygotuj się · G-PRZ-04"| E07
  E06 -->|"Zakończ"| E05
  E06 ==>|"Zakończ ostatnie · PRJ-01"| E09
  E06 -->|"Projekt"| E09
  E06 -->|"Kontekst"| E11
  E06 -.->|"Wstecz"| E05

  E07 -->|"Odhacz / Wszystkie"| E07
  E07 ==>|"Przygotowane → Zacznij"| E06
  E07 -->|"Sklep"| E11
  E07 -.->|"Zamknij"| E06

  E08 -->|"Projekt"| E09
  E08 -.->|"Dalej w Przeglądzie"| E14
  E09 ==>|"Dodaj następne · D-26"| E06
  E09 ==>|"Odłóż · D-26"| E13
  E09 ==>|"Zakończ Projekt · D-26"| E19
  E09 ==>|"Przygotuj się · G-PRJ-09"| E07
  E09 -->|"Działanie"| E06
  E09 -.->|"Wstecz"| E08

  E19 ==>|"Pokaż Projekty Utknięte · D-35"| E08
  E19 -->|"Projekty"| E08

  E10 -->|"Kontekst"| E11
  E11 -->|"Odhacz Pozycję"| E11
  E11 -->|"Działanie"| E06
  E11 -->|"Lista przygotowania"| E07
  E11 -.->|"Wstecz"| E10

  E12 ==>|"Skontaktuj się · D-30"| EXT
  E12 ==>|"Przesuń kontrolę · D-30"| E12
  E12 -->|"Działanie"| E06
  E12 -.->|"Dalej w Przeglądzie"| E14
  EXT -.->|"powrót"| E12

  E13 -->|"Aktywuj"| E09
  E13 -.->|"Dalej w Przeglądzie"| E14

  E14 -->|"Punkt: Inbox"| E04
  E14 -->|"Punkt: Projekty"| E08
  E14 -->|"Punkt: Czekam na"| E12
  E14 -->|"Punkt: Kalendarz"| E15
  E14 -->|"Punkt: Kiedyś/może"| E13
